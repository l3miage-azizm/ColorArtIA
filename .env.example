# Configure these in the hosting dashboard; no secrets belong in the image.
PORT=8000
COLORART_DATA_DIR=/data
# Trust all forwarded headers only behind the provider's HTTPS-only public edge.
FORWARDED_ALLOW_IPS=*
# Optional: enter your key directly in the hosting secret manager.
# COLORART_IMAGE_API_KEY=
# COLORART_IMAGE_BASE_URL=https://api.openai.com/v1
# COLORART_IMAGE_MODEL=gpt-image-1.5
# Vercel alternative: use the deployment's rotating OIDC identity (no browser key).
# COLORART_IMAGE_PROVIDER=vercel_gateway
# COLORART_ARTISTIC_READY=auto
# COLORART_IMAGE_MODEL=openai/gpt-image-2
# auto checks service availability without generating an image; 0 disables it.
